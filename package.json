{
  "name": "momax-render-service",
  "description": "3D 模型渲染服务 - 将 FBX/GLB 模型渲染为 MP4/GIF 视频",
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.26.0",
  "author": "alpen",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && pnpm build:renderer",
    "build:renderer": "tsx scripts/build-renderer.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:render": "tsx src/test/render.test.ts",
    "test:concat": "tsx src/test/concat.test.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf node_modules dist public/renderer"
  },
  "dependencies": {
    "fluent-ffmpeg": "^2.1.3",
    "pino": "^9.0.0",
    "pino-pretty": "^11.0.0",
    "puppeteer": "^23.0.0",
    "three": "^0.182.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.26",
    "@types/node": "^22.0.0",
    "@types/three": "^0.182.0",
    "@types/uuid": "^10.0.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "~5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "puppeteer"
    ]
  }
}
